# Copy to .env and fill in. Never commit .env.

# --- General ---
TIMEZONE=Europe/Berlin
DB_PATH=data/booking.db
SALON_FILE=app/salon.json
# Admins: "<channel>:<user id>", comma separated (WhatsApp id = phone without +)
ADMIN_IDS=whatsapp:4915112345678,viber:VIBER_USER_ID==
# 1 = enable local emulator at /demo (turn off in production)
DEMO_MODE=1
REMINDER_INTERVAL_S=60

# --- WhatsApp Cloud API (Meta, official) ---
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=choose-a-random-string
WA_APP_SECRET=
WA_API_VERSION=v23.0

# --- Viber Bot API ---
VIBER_AUTH_TOKEN=
VIBER_BOT_NAME=Studio Nord

# --- Optional export: none | csv | google ---
SHEETS_EXPORTER=none
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=
